rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images are stored under the player's UID so every thread for that player
    // can use the same private upload permission.
    match /chat-uploads/{playerUid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == playerUid
          || request.auth.uid == '69EkQfAkuShSM5Fe5pCEs8nOv0l2');

      allow write: if request.auth != null
        && (request.auth.uid == playerUid
          || request.auth.uid == '69EkQfAkuShSM5Fe5pCEs8nOv0l2')
        && (
          request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'))
        );
    }
  }
}
